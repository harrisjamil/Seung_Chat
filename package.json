{
  "name": "my-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:pull": "prisma db pull",
    "desktop:compile": "tsc -p desktop/tsconfig.json",
    "desktop:dev": "npm run desktop:compile && concurrently -k \"npm run dev\" \"wait-on http://localhost:3000 && node scripts/run-desktop.mjs\"",
    "desktop:start": "npm run desktop:compile && node scripts/run-desktop.mjs",
    "desktop:pack": "npm run desktop:compile && electron-builder --project desktop --dir",
    "desktop:build": "node scripts/desktop-build.mjs",
    "desktop:icon": "node scripts/generate-desktop-icon.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1058.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.16.0",
    "motion": "^12.40.0",
    "next": "16.2.6",
    "nodemailer": "^8.0.10",
    "pg": "^8.21.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.8.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "whatsapp-web.js": "^1.34.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.3",
    "electron": "^36.9.5",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "postcss": "^8.5.15",
    "prisma": "^7.8.0",
    "sharp": "^0.35.2",
    "tailwindcss": "^4.3.0",
    "typescript": "^5",
    "wait-on": "^8.0.5"
  }
}
